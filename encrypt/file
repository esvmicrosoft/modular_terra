az keyvault key create --vault-name $vault -n $kek --protection software
touch /tmp/keyvault

az keyvault update -n $vault --public-network-access Enabled --bypass AzureServices --default-action Allow -o none
az keyvault show -n $vault --query "properties.publicNetworkAccess" -o tsv   # debe imprimir: Enabled
 
 
az vm encryption enable -g $rg -n $vm \
  --disk-encryption-keyvault $vault \
  --key-encryption-key $kek \
  --key-encryption-keyvault $vault \
  --volume-type All

az vm encryption show -g $rg -n $vm \
  --query "{disk:disks[0].statuses[0].displayStatus, progress:status[0].message, sub:substatus[0].message}" -o json
